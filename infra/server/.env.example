# n8n Self-Host Stack — Environment-Variablen
#
# Kopiere diese Datei zu .env und fülle die Werte aus.
# WICHTIG:
# - .env wird NICHT ins Git committed (siehe .gitignore)
# - N8N_ENCRYPTION_KEY darf NIEMALS geändert werden, sonst sind alle
#   gespeicherten Credentials kaputt. Sichere ihn zusätzlich extern
#   (1Password / Bitwarden / verschlüsselte Notiz).

# === Domain ===
# Subdomain, unter der n8n erreichbar ist. Caddy macht das TLS.
N8N_HOST=n8n.kirenz.de

# === Postgres ===
# Postgres-Superuser (nur für Init, n8n nutzt den non-root)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=BITTE-AENDERN-langes-zufaelliges-passwort-32-chars
POSTGRES_DB=n8n
# Eigener n8n-User mit beschränkten Rechten (wird vom Init-Skript angelegt)
POSTGRES_NON_ROOT_USER=n8n_user
POSTGRES_NON_ROOT_PASSWORD=BITTE-AENDERN-anderes-langes-zufaelliges-passwort-32-chars

# === n8n Encryption Key ===
# Generiere einen mit: openssl rand -hex 32
# DIESE VARIABLE NIE WIEDER ÄNDERN nach dem ersten Start.
N8N_ENCRYPTION_KEY=BITTE-AENDERN-openssl-rand-hex-32-output-hier-einsetzen

# === Zeitzone ===
TIMEZONE=Europe/Berlin

# === Storage Box (optional, für Off-Site-Backups) ===
# Wenn diese drei Vars gesetzt sind, syncht backup.sh täglich zur Storage Box.
# Pfad-Konvention: STORAGE_BOX_REMOTE_DIR ist der Unterordner auf der Box
# (default: "n8n"). Die Lernplattform nutzt z.B. "lernplattform/" auf
# derselben Box — kollidiert nicht.
STORAGE_BOX_HOST=u580735.your-storagebox.de
STORAGE_BOX_USER=u580735
STORAGE_BOX_PORT=23
STORAGE_BOX_KEY=/root/.ssh/storagebox
STORAGE_BOX_REMOTE_DIR=n8n
