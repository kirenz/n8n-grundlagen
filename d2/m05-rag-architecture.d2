direction: right

ingestion: {
  label: "1. Ingestion\nFAQ in Tabelle"
  shape: rectangle
  style: {
    fill: "#ffffff"
    stroke: "#e4e4e7"
    stroke-width: 1
    border-radius: 8
    font-color: "#18181b"
  }
}

vector: {
  label: "2. Vector-DB\nEmbeddings"
  shape: rectangle
  style: {
    fill: "#ffffff"
    stroke: "#e4e4e7"
    stroke-width: 1
    border-radius: 8
    font-color: "#18181b"
  }
}

retrieval: {
  label: "3. Retrieval\nTop-K Treffer"
  shape: rectangle
  style: {
    fill: "#ffffff"
    stroke: "#e4e4e7"
    stroke-width: 1
    border-radius: 8
    font-color: "#18181b"
  }
}

generation: {
  label: "4. Generation\nKI-Antwort"
  shape: rectangle
  style: {
    fill: "#18181b"
    stroke: "#18181b"
    stroke-width: 1
    border-radius: 8
    font-color: "#fafafa"
    bold: true
  }
}

mail: {
  label: "Mail-Frage"
  shape: rectangle
  style: {
    fill: "#ffffff"
    stroke: "#e4e4e7"
    stroke-width: 1
    border-radius: 8
    font-color: "#18181b"
  }
}

draft: {
  label: "Antwort-Draft\nin Inbox"
  shape: rectangle
  style: {
    fill: "#ffffff"
    stroke: "#e4e4e7"
    stroke-width: 1
    border-radius: 8
    font-color: "#18181b"
  }
}

ingestion -> vector: "indexieren" {style: {stroke: "#a1a1aa"; stroke-width: 2}}
mail -> retrieval: "Suchanfrage" {style: {stroke: "#a1a1aa"; stroke-width: 2}}
vector -> retrieval: "Vektor-Index" {style: {stroke: "#a1a1aa"; stroke-width: 2}}
retrieval -> generation: "Kontext + Frage" {style: {stroke: "#a1a1aa"; stroke-width: 2}}
generation -> draft: {style: {stroke: "#a1a1aa"; stroke-width: 2}}
