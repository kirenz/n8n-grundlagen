direction: right

trigger: {
  label: "Mail-Eingang\n(IMAP / Manual)"
  shape: rectangle
  style: {
    fill: "#ffffff"
    stroke: "#e4e4e7"
    stroke-width: 1
    border-radius: 8
    font-color: "#18181b"
  }
}

reply: {
  label: "Bestätigung\n(SMTP)"
  shape: rectangle
  style: {
    fill: "#18181b"
    stroke: "#18181b"
    stroke-width: 1
    border-radius: 8
    font-color: "#fafafa"
    bold: true
  }
}

table: {
  label: "Eingangsbuch\n(n8n Data Table)"
  shape: rectangle
  style: {
    fill: "#ffffff"
    stroke: "#e4e4e7"
    stroke-width: 1
    border-radius: 8
    font-color: "#18181b"
  }
}

trigger -> reply: "Absender, Betreff" {
  style: {
    stroke: "#a1a1aa"
    stroke-width: 2
  }
}

reply -> table: "Eintrag\nanlegen" {
  style: {
    stroke: "#a1a1aa"
    stroke-width: 2
  }
}
