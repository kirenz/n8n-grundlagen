 }
}
a -> b: {style: {stroke: "#a1a1aa"; stroke-width: 2}}
b -> c: "Testzugriff" {style: {stroke: "#a1a1aa"; stroke-width: 2}}
d -> e: {style: {stroke: "#a1a1aa"; stroke-width: 2}}
e -> f: "Produktivzugriff" {style: {stroke: "#a1a1aa"; stroke-width: 2}}
