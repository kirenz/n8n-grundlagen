direction: right

a: {
 label: "Plattform\neinordnen"
 shape: rectangle
 style: {
  fill: "#ffffff"
  stroke: "#e4e4e7"
  stroke-width: 1
  border-radius: 8
  font-color: "#18181b"
 }
}
b: {
 label: "Eigene Instanz\neinrichten"
 shape: rectangle
 style: {
  fill: "#18181b"
  stroke: "#e4e4e7"
  stroke-width: 2
  border-radius: 8
  font-color: "#fafafa"
  bold: true
 }
}
c: {
 label: "Mail-Workflow\nbauen"
 shape: rectangle
 style: {
  fill: "#ffffff"
  stroke: "#e4e4e7"
  stroke-width: 1
  border-radius: 8
  font-color: "#18181b"
 }
}
a -> b: {style: {stroke: "#a1a1aa"; stroke-width: 2}}
b -> c: {style: {stroke: "#a1a1aa"; stroke-width: 2}}
