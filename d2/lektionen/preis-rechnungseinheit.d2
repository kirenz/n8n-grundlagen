direction: right

workflow: {
  label: "Ein Workflow\n50 Schritte"
  style: {fill: "#18181b"; stroke: "#18181b"; stroke-width: 2; border-radius: 8; font-color: "#fafafa"; bold: true}
}

task: {
  label: "Rechnung A\nEinzelne Schritte zählen"
  style: {fill: "#ffffff"; stroke: "#e4e4e7"; stroke-width: 1; border-radius: 8; font-color: "#18181b"}
}

execution: {
  label: "Rechnung B\nVollständige Durchläufe zählen"
  style: {fill: "#ffffff"; stroke: "#e4e4e7"; stroke-width: 1; border-radius: 8; font-color: "#18181b"}
}

workflow -> task {style: {stroke: "#a1a1aa"; stroke-width: 2}}
workflow -> execution {style: {stroke: "#a1a1aa"; stroke-width: 2}}
