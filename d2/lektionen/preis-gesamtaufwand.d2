direction: right

lizenz: {
  label: "Lizenzkosten"
  style: {fill: "#ffffff"; stroke: "#e4e4e7"; stroke-width: 1; border-radius: 8; font-color: "#18181b"}
}

lernen: {
  label: "Einarbeitung"
  style: {fill: "#ffffff"; stroke: "#e4e4e7"; stroke-width: 1; border-radius: 8; font-color: "#18181b"}
}

pflege: {
  label: "Workflow-Pflege"
  style: {fill: "#ffffff"; stroke: "#e4e4e7"; stroke-width: 1; border-radius: 8; font-color: "#18181b"}
}

migration: {
  label: "Migration"
  style: {fill: "#ffffff"; stroke: "#e4e4e7"; stroke-width: 1; border-radius: 8; font-color: "#18181b"}
}

gesamt: {
  label: "Gesamten Aufwand\nvergleichen"
  style: {fill: "#18181b"; stroke: "#18181b"; stroke-width: 2; border-radius: 8; font-color: "#fafafa"; bold: true}
}

lizenz -> gesamt {style: {stroke: "#a1a1aa"; stroke-width: 2}}
