direction: right

a: {
 label: "Neue Formular-\nnachricht"
 shape: rectangle
 style: {
  fill: "#ffffff"
  stroke: "#e4e4e7"
  stroke-width: 1
  border-radius: 8
  font-color: "#18181b"
 }
}
b: {
 label: "Bestätigung\nsenden"
 shape: rectangle
 style: {
  fill: "#18181b"
  stroke: "#e4e4e7"
  stroke-width: 2
  border-radius: 8
  font-color: "#fafafa"
  bold: true
 }
}
c: {
 label: "Nachricht als\nTabellenzeile"
 shape: rectangle
 style: {
  fill: "#ffffff"
  stroke: "#e4e4e7"
  stroke-width: 1
  border-radius: 8
  font-color: "#18181b"
 }
}
a -> b: "Auslöser" {style: {stroke: "#a1a1aa"; stroke-width: 2}}
b -> c: "Nachricht weitergeben" {style: {stroke: "#a1a1aa"; stroke-width: 2}}
