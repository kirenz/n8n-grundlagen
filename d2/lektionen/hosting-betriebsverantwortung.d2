direction: right

pflege: {
  label: "Updates, Backups,\nTLS und Monitoring\nWer übernimmt den Betrieb?"
  style: {fill: "#18181b"; stroke: "#18181b"; stroke-width: 2; border-radius: 8; font-color: "#fafafa"; bold: true}
}

cloud: {
  label: "Cloud\nn8n"
  style: {fill: "#ffffff"; stroke: "#e4e4e7"; stroke-width: 1; border-radius: 8; font-color: "#18181b"}
}

self: {
  label: "Self-Hosted\nEigenes Team"
  style: {fill: "#ffffff"; stroke: "#e4e4e7"; stroke-width: 1; border-radius: 8; font-color: "#18181b"}
}

managed: {
  label: "Managed Hosting\nDrittanbieter"
  style: {fill: "#ffffff"; stroke: "#e4e4e7"; stroke-width: 1; border-radius: 8; font-color: "#18181b"}
}

pflege -> cloud {style: {stroke: "#a1a1aa"; stroke-width: 2}}
pflege -> self {style: {stroke: "#a1a1aa"; stroke-width: 2}}
pflege -> managed {style: {stroke: "#a1a1aa"; stroke-width: 2}}
