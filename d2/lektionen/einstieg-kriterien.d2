 }
}
a -> b: "Ja" {style: {stroke: "#a1a1aa"; stroke-width: 2}}
b -> c: "Ja" {style: {stroke: "#a1a1aa"; stroke-width: 2}}
c -> d: "Ja" {style: {stroke: "#a1a1aa"; stroke-width: 2}}
a -> e: "Nein" {style: {stroke: "#a1a1aa"; stroke-width: 2}}
b -> f: "Nein" {style: {stroke: "#a1a1aa"; stroke-width: 2}}
c -> g: "Nein" {style: {stroke: "#a1a1aa"; stroke-width: 2}}
