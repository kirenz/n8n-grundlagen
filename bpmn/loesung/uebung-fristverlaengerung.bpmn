<?xml version="1.0" encoding="UTF-8"?>
<!-- Lehrdiagramm für den Kurs n8n-Grundlagen, Kapitel „Abläufe modellieren mit BPMN“. Synthetisches Beispiel (Kundenservice eines Online-Shops). Erzeugt von processes/n8n-grundlagen/build.mjs; gerendert mit bpmn-js (bpmn.io). -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_uebung-fristverlaengerung" targetNamespace="http://kirenz.de/n8n-grundlagen" exporter="process-lab" exporterVersion="0.1">
  <bpmn:collaboration id="Collab_uebung-fristverlaengerung">
    <bpmn:participant id="Pool_Kunde" name="Kunde" />
    <bpmn:participant id="Pool_Shop" name="Online-Shop" processRef="Process_Pool_Shop" />
    <bpmn:messageFlow id="M1" name="Antrag mit Nachweis" sourceRef="Pool_Kunde" targetRef="Start" />
    <bpmn:messageFlow id="M2" name="Ablehnung" sourceRef="T2" targetRef="Pool_Kunde" />
    <bpmn:messageFlow id="M3" name="Bestätigung" sourceRef="T3" targetRef="Pool_Kunde" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_Shop" name="Rückgabefrist verlängern" isExecutable="false">
    <bpmn:laneSet id="LaneSet_uebung-fristverlaengerung">
      <bpmn:lane id="Lane_Service" name="Kundenservice">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ende1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ende2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Antrag eingegangen">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Antrag prüfen">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Nachweis vollständig?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T2" name="Antrag ablehnen">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      
    </bpmn:sendTask>
    <bpmn:endEvent id="Ende1" name="Antrag abgelehnt">
      <bpmn:incoming>F4</bpmn:incoming>
      
    </bpmn:endEvent>
    <bpmn:parallelGateway id="G2">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="T3" name="Bestätigung versenden">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      
    </bpmn:sendTask>
    <bpmn:serviceTask id="T4" name="Status auf „Rückgabe verlängert“ setzen">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      
      <bpmn:dataOutputAssociation id="A1"><bpmn:targetRef>S1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="G3">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="Ende2" name="Frist verlängert">
      <bpmn:incoming>F10</bpmn:incoming>
      
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="F3" name="nein" sourceRef="G1" targetRef="T2" />
    <bpmn:sequenceFlow id="F4" sourceRef="T2" targetRef="Ende1" />
    <bpmn:sequenceFlow id="F5" name="ja" sourceRef="G1" targetRef="G2" />
    <bpmn:sequenceFlow id="F6" sourceRef="G2" targetRef="T3" />
    <bpmn:sequenceFlow id="F7" sourceRef="G2" targetRef="T4" />
    <bpmn:sequenceFlow id="F8" sourceRef="T3" targetRef="G3" />
    <bpmn:sequenceFlow id="F9" sourceRef="T4" targetRef="G3" />
    <bpmn:sequenceFlow id="F10" sourceRef="G3" targetRef="Ende2" />
    <bpmn:dataStoreReference id="S1" name="Shop-System" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_uebung-fristverlaengerung">
    <bpmndi:BPMNPlane id="Plane_uebung-fristverlaengerung" bpmnElement="Collab_uebung-fristverlaengerung">
      <bpmndi:BPMNShape id="Pool_Kunde_di" bpmnElement="Pool_Kunde" isHorizontal="true"><dc:Bounds x="0" y="0" width="1120" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_Shop_di" bpmnElement="Pool_Shop" isHorizontal="true"><dc:Bounds x="0" y="120" width="1120" height="360" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Service_di" bpmnElement="Lane_Service" isHorizontal="true"><dc:Bounds x="30" y="120" width="1090" height="360" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="82" y="242" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="50" y="282" width="100" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="170" y="220" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="375" y="235" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="335" y="290" width="130" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="510" y="140" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ende1_di" bpmnElement="Ende1"><dc:Bounds x="702" y="162" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="670" y="202" width="100" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_di" bpmnElement="G2" isMarkerVisible="true"><dc:Bounds x="535" y="235" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="710" y="220" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="710" y="300" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G3_di" bpmnElement="G3" isMarkerVisible="true"><dc:Bounds x="915" y="235" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ende2_di" bpmnElement="Ende2"><dc:Bounds x="1042" y="242" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1015" y="282" width="90" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="118" y="260" /><di:waypoint x="170" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="310" y="260" /><di:waypoint x="375" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="400" y="235" /><di:waypoint x="400" y="180" /><di:waypoint x="510" y="180" /><bpmndi:BPMNLabel><dc:Bounds x="408" y="205" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="650" y="180" /><di:waypoint x="702" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="425" y="260" /><di:waypoint x="535" y="260" /><bpmndi:BPMNLabel><dc:Bounds x="430" y="240" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="585" y="260" /><di:waypoint x="710" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="560" y="285" /><di:waypoint x="560" y="340" /><di:waypoint x="710" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="850" y="260" /><di:waypoint x="915" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="850" y="340" /><di:waypoint x="940" y="340" /><di:waypoint x="940" y="285" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="965" y="260" /><di:waypoint x="1042" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M1_di" bpmnElement="M1"><di:waypoint x="100" y="60" /><di:waypoint x="100" y="242" /><bpmndi:BPMNLabel><dc:Bounds x="108" y="100" width="120" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M2_di" bpmnElement="M2"><di:waypoint x="580" y="140" /><di:waypoint x="580" y="60" /><bpmndi:BPMNLabel><dc:Bounds x="588" y="100" width="120" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M3_di" bpmnElement="M3"><di:waypoint x="780" y="220" /><di:waypoint x="780" y="60" /><bpmndi:BPMNLabel><dc:Bounds x="788" y="100" width="120" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="755" y="400" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="730" y="454" width="100" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="A1_di" bpmnElement="A1"><di:waypoint x="780" y="380" /><di:waypoint x="780" y="400" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
