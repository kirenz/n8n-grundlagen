<?xml version="1.0" encoding="UTF-8"?>
<!-- Lehrdiagramm für den Kurs n8n-Grundlagen, Kapitel „Abläufe modellieren mit BPMN“. Synthetisches Beispiel (Kundenservice eines Online-Shops). Erzeugt von processes/n8n-grundlagen/build.mjs; gerendert mit bpmn-js (bpmn.io). -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_kulanzantrag-pruefung" targetNamespace="http://kirenz.de/n8n-grundlagen" exporter="process-lab" exporterVersion="0.1">
  <bpmn:collaboration id="Collab_kulanzantrag-pruefung">
    <bpmn:participant id="Pool_Fach" name="Fachabteilung" processRef="Process_Pool_Fach" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_Fach" name="Reklamierte Position prüfen" isExecutable="false">
    <bpmn:laneSet id="LaneSet_kulanzantrag-pruefung">
      <bpmn:lane id="Lane_Fach" name="Fachabteilung">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ende</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Position zur Prüfung erhalten">
      <bpmn:outgoing>F1</bpmn:outgoing>
      
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Belege sichten">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      
    </bpmn:userTask>
    <bpmn:parallelGateway id="G1">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T2" name="Mangel mit Spezifikation abgleichen">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      
    </bpmn:userTask>
    <bpmn:userTask id="T3" name="Kaufdatum und Nutzung prüfen">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      
    </bpmn:userTask>
    <bpmn:parallelGateway id="G2">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="G3" name="Kulanzrichtlinie erfüllt?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T4" name="Kulanz empfehlen">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      
    </bpmn:userTask>
    <bpmn:userTask id="T5" name="Abweichung festhalten">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      
    </bpmn:userTask>
    <bpmn:userTask id="T6" name="Ablehnung empfehlen">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G4">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T7" name="Empfehlung im Prüfformular eintragen">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      
    </bpmn:userTask>
    <bpmn:endEvent id="Ende" name="Empfehlung abgegeben">
      <bpmn:incoming>F14</bpmn:incoming>
      
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="F3" sourceRef="G1" targetRef="T2" />
    <bpmn:sequenceFlow id="F4" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="F5" sourceRef="T2" targetRef="G2" />
    <bpmn:sequenceFlow id="F6" sourceRef="T3" targetRef="G2" />
    <bpmn:sequenceFlow id="F7" sourceRef="G2" targetRef="G3" />
    <bpmn:sequenceFlow id="F8" name="ja" sourceRef="G3" targetRef="T4" />
    <bpmn:sequenceFlow id="F9" name="nein" sourceRef="G3" targetRef="T5" />
    <bpmn:sequenceFlow id="F10" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="F11" sourceRef="T4" targetRef="G4" />
    <bpmn:sequenceFlow id="F12" sourceRef="T6" targetRef="G4" />
    <bpmn:sequenceFlow id="F13" sourceRef="G4" targetRef="T7" />
    <bpmn:sequenceFlow id="F14" sourceRef="T7" targetRef="Ende" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_kulanzantrag-pruefung">
    <bpmndi:BPMNPlane id="Plane_kulanzantrag-pruefung" bpmnElement="Collab_kulanzantrag-pruefung">
      <bpmndi:BPMNShape id="Pool_Fach_di" bpmnElement="Pool_Fach" isHorizontal="true"><dc:Bounds x="0" y="0" width="1660" height="320" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Fach_di" bpmnElement="Lane_Fach" isHorizontal="true"><dc:Bounds x="30" y="0" width="1630" height="320" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="82" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="45" y="182" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="170" y="120" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="365" y="135" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="470" y="40" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="470" y="200" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_di" bpmnElement="G2" isMarkerVisible="true"><dc:Bounds x="665" y="135" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G3_di" bpmnElement="G3" isMarkerVisible="true"><dc:Bounds x="795" y="135" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="755" y="105" width="130" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="910" y="40" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="910" y="200" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T6_di" bpmnElement="T6"><dc:Bounds x="1080" y="200" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G4_di" bpmnElement="G4" isMarkerVisible="true"><dc:Bounds x="1275" y="135" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T7_di" bpmnElement="T7"><dc:Bounds x="1360" y="120" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ende_di" bpmnElement="Ende"><dc:Bounds x="1562" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1530" y="182" width="100" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="118" y="160" /><di:waypoint x="170" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="310" y="160" /><di:waypoint x="365" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="390" y="135" /><di:waypoint x="390" y="80" /><di:waypoint x="470" y="80" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="390" y="185" /><di:waypoint x="390" y="240" /><di:waypoint x="470" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="610" y="80" /><di:waypoint x="690" y="80" /><di:waypoint x="690" y="135" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="610" y="240" /><di:waypoint x="690" y="240" /><di:waypoint x="690" y="185" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="715" y="160" /><di:waypoint x="795" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="820" y="135" /><di:waypoint x="820" y="80" /><di:waypoint x="910" y="80" /><bpmndi:BPMNLabel><dc:Bounds x="828" y="120" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="820" y="185" /><di:waypoint x="820" y="240" /><di:waypoint x="910" y="240" /><bpmndi:BPMNLabel><dc:Bounds x="828" y="200" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1050" y="240" /><di:waypoint x="1080" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1050" y="80" /><di:waypoint x="1300" y="80" /><di:waypoint x="1300" y="135" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1220" y="240" /><di:waypoint x="1300" y="240" /><di:waypoint x="1300" y="185" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="1325" y="160" /><di:waypoint x="1360" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="1500" y="160" /><di:waypoint x="1562" y="160" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
