<?xml version="1.0" encoding="UTF-8"?>
<!-- Lehrdiagramm für den Kurs n8n-Grundlagen, Kapitel „Abläufe modellieren mit BPMN“. Synthetisches Beispiel (Kundenservice eines Online-Shops). Erzeugt von processes/n8n-grundlagen/build.mjs; gerendert mit bpmn-js (bpmn.io). -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_kulanzantrag-loesung" targetNamespace="http://kirenz.de/n8n-grundlagen" exporter="process-lab" exporterVersion="0.1">
  <bpmn:collaboration id="Collab_kulanzantrag-loesung">
    <bpmn:participant id="Pool_Kunde" name="Kunde" />
    <bpmn:participant id="Pool_Shop" name="Online-Shop" processRef="Process_Pool_Shop" />
    <bpmn:messageFlow id="M1" name="Antrag mit Belegen" sourceRef="Pool_Kunde" targetRef="Start" />
    <bpmn:messageFlow id="M2" name="Nachforderung" sourceRef="T2" targetRef="Pool_Kunde" />
    <bpmn:messageFlow id="M3" name="Belege" sourceRef="Pool_Kunde" targetRef="E1" />
    <bpmn:messageFlow id="M4" name="Mitteilung" sourceRef="T3" targetRef="Pool_Kunde" />
    <bpmn:messageFlow id="M5" name="Bescheid" sourceRef="T10" targetRef="Pool_Kunde" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_Shop" name="Kulanzantrag bearbeiten" isExecutable="false">
    <bpmn:laneSet id="LaneSet_kulanzantrag-loesung">
      <bpmn:lane id="Lane_Service" name="Kundenservice">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ende1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ende2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ende3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Fach" name="Fachabteilung">
        <bpmn:flowNodeRef>SP</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Leitung" name="Teamleitung Kundenservice">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Antrag eingegangen">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Antrag auf Vollständigkeit prüfen">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      
      <bpmn:property id="Prop_A1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="A1"><bpmn:sourceRef>D1</bpmn:sourceRef><bpmn:targetRef>Prop_A1</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Antrag vollständig?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T2" name="Belege nachfordern">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="G2">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="E1" name="Belege eingegangen">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E2" name="14 Tage verstrichen">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="T3" name="Kunden über Schließung informieren">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      
    </bpmn:sendTask>
    <bpmn:endEvent id="Ende1" name="Antrag zurückgezogen">
      <bpmn:incoming>F9</bpmn:incoming>
      
    </bpmn:endEvent>
    <bpmn:subProcess id="SP" name="Reklamierte Position prüfen">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="B1" name="3 Werktage ohne Empfehlung" attachedToRef="SP" cancelActivity="false">
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="T5" name="Fachabteilung erinnern">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      
    </bpmn:userTask>
    <bpmn:endEvent id="Ende2" name="Erinnerung versendet">
      <bpmn:incoming>F12</bpmn:incoming>
      
    </bpmn:endEvent>
    <bpmn:userTask id="T6" name="Über Kulanz entscheiden">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="G3" name="Ergebnis der Entscheidung?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="T8" name="Ablehnung begründen">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      
    </bpmn:userTask>
    <bpmn:serviceTask id="T7" name="Gutschrift verbuchen">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      
      <bpmn:dataOutputAssociation id="A3"><bpmn:targetRef>S1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="G4">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="T9" name="Bescheid erstellen">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
      
      <bpmn:dataOutputAssociation id="A2"><bpmn:targetRef>D2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:parallelGateway id="G5">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="T10" name="Bescheid versenden">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      
    </bpmn:sendTask>
    <bpmn:serviceTask id="T11" name="Antrag und Bescheid archivieren">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
      
      <bpmn:dataOutputAssociation id="A4"><bpmn:targetRef>S2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="G6">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="Ende3" name="Antrag abschließend bearbeitet">
      <bpmn:incoming>F25</bpmn:incoming>
      
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="F3" name="nein" sourceRef="G1" targetRef="T2" />
    <bpmn:sequenceFlow id="F4" sourceRef="T2" targetRef="G2" />
    <bpmn:sequenceFlow id="F5" sourceRef="G2" targetRef="E1" />
    <bpmn:sequenceFlow id="F6" sourceRef="G2" targetRef="E2" />
    <bpmn:sequenceFlow id="F7" sourceRef="E1" targetRef="T1" />
    <bpmn:sequenceFlow id="F8" sourceRef="E2" targetRef="T3" />
    <bpmn:sequenceFlow id="F9" sourceRef="T3" targetRef="Ende1" />
    <bpmn:sequenceFlow id="F10" name="ja" sourceRef="G1" targetRef="SP" />
    <bpmn:sequenceFlow id="F11" sourceRef="B1" targetRef="T5" />
    <bpmn:sequenceFlow id="F12" sourceRef="T5" targetRef="Ende2" />
    <bpmn:sequenceFlow id="F13" sourceRef="SP" targetRef="T6" />
    <bpmn:sequenceFlow id="F14" sourceRef="T6" targetRef="G3" />
    <bpmn:sequenceFlow id="F15" name="mind. eine Position abgelehnt" sourceRef="G3" targetRef="T8" />
    <bpmn:sequenceFlow id="F16" name="mind. eine Position anerkannt" sourceRef="G3" targetRef="T7" />
    <bpmn:sequenceFlow id="F17" sourceRef="T8" targetRef="G4" />
    <bpmn:sequenceFlow id="F18" sourceRef="T7" targetRef="G4" />
    <bpmn:sequenceFlow id="F19" sourceRef="G4" targetRef="T9" />
    <bpmn:sequenceFlow id="F20" sourceRef="T9" targetRef="G5" />
    <bpmn:sequenceFlow id="F21" sourceRef="G5" targetRef="T10" />
    <bpmn:sequenceFlow id="F22" sourceRef="G5" targetRef="T11" />
    <bpmn:sequenceFlow id="F23" sourceRef="T10" targetRef="G6" />
    <bpmn:sequenceFlow id="F24" sourceRef="T11" targetRef="G6" />
    <bpmn:sequenceFlow id="F25" sourceRef="G6" targetRef="Ende3" />
    <bpmn:dataObjectReference id="D1" name="Kulanzantrag mit Belegen" dataObjectRef="DO_D1" />
    <bpmn:dataObject id="DO_D1" />
    <bpmn:dataObjectReference id="D2" name="Bescheid" dataObjectRef="DO_D2" />
    <bpmn:dataObject id="DO_D2" />
    <bpmn:dataStoreReference id="S1" name="Shop-System" />
    <bpmn:dataStoreReference id="S2" name="Kundenakte" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Frist laut Kulanzrichtlinie: 14 Tage. Danach gilt der Antrag als zurückgezogen.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N2"><bpmn:text>Teilweise Kulanz: Gutschrift und Begründung laufen beide.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A5" sourceRef="N1" targetRef="E2" />
    <bpmn:association id="A6" sourceRef="N2" targetRef="G3" />
  </bpmn:process>
